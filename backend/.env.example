# =========================================================
# AI饮食健康助手 - 环境配置
# 使用说明：复制此文件为 .env，然后修改下面的参数
#   cp .env.example .env     (Linux/Mac)
#   copy .env.example .env   (Windows)
# =========================================================

# ---------- MySQL 数据库 (必填) ----------
# 确保 MySQL 已启动，并已创建数据库：
#   CREATE DATABASE ai_diet_health DEFAULT CHARACTER SET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ai_diet_health

# ---------- JWT 认证 (必填) ----------
# 修改为一个长随机字符串，越长越安全
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- LLM 大模型 API (可选，用于食谱推荐) ----------
# 支持 OpenAI 兼容接口
LLM_API_KEY=sk-your-api-key-here
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo

# ---------- YOLOv8 食物识别 (可选) ----------
# .pt 模型文件路径，放在 backend/models/ 目录下
YOLO_MODEL_PATH=models/yolov8_food.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
