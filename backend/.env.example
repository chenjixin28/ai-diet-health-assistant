# =========================================================
# AI饮食健康助手 - 环境配置
# 使用说明：复制此文件为 .env，然后修改下面的参数
#   cp .env.example .env     (Linux/Mac)
#   copy .env.example .env   (Windows)
# =========================================================

# ---------- MySQL 数据库 (必填) ----------
# 确保 MySQL 已启动，并已创建数据库：
#   CREATE DATABASE ai_diet_health DEFAULT CHARACTER SET utf8mb4;
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ai_diet_health

# ---------- JWT 认证 (必填) ----------
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- DeepSeek API (必填，用于食物识别) ----------
# 注册地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 食物识别模式 ----------
# deepseek: 使用DeepSeek Vision API（推荐，无需训练）
# yolo: 使用本地YOLO模型（需要训练好的.pt文件）
# mock: 使用模拟数据（开发测试用）
FOOD_RECOGNITION_MODE=deepseek

# ---------- YOLOv8 食物识别 (备用) ----------
# yolov8_food_world.pt: YOLO-World开放词汇模型，可识别36类食物
# yolov8n.pt: 官方预训练模型，仅80类通用物体
YOLO_MODEL_PATH=models/yolov8_food_world.pt
YOLO_CONFIDENCE_THRESHOLD=0.5
